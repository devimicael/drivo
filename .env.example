# ============================================================
# DRIVO — variáveis de ambiente (placeholders; segredos reais
# ficam APENAS no .env local, que nunca é versionado)
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Banco de dados ---
DATABASE_URL=postgresql://drivo:TROQUE_A_SENHA@localhost:5433/drivo?schema=public

# --- Autenticação (JWT + CSRF) ---
JWT_SECRET=troque-por-uma-string-aleatoria-com-no-minimo-32-caracteres
JWT_TTL_SECONDS=3600
CSRF_SECRET=troque-por-uma-string-aleatoria-distinta-da-jwt-secret
COOKIE_SECURE=false

# --- CORS (origens explícitas, separadas por vírgula) ---
CORS_ORIGINS=http://localhost:3001

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5
SCAN_THROTTLE_LIMIT=10

# --- Upload de CRLV ---
UPLOAD_MAX_BYTES=5242880

# --- Gemini (opcional em dev: a app sobe sem a chave) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3000
