# Exclui artefatos locais do contexto de build (raiz do monorepo).
# Sem isto, o COPY das apps sobrescreve o node_modules limpo da imagem
# com os links/junctions do Windows (quebra: MODULE_NOT_FOUND prisma).

**/node_modules
**/.next
**/dist
**/coverage
**/.env
**/.env.*
!**/.env.example
.git
.impeccable
.security-tests
docs/
scripts/
apps/api/test/
apps/api/src/**/*.spec.ts
apps/web/src/**/*.test.ts
apps/web/src/**/*.test.tsx
apps/web/src/**/*.spec.ts
apps/web/src/**/*.spec.tsx
apps/web/design-qa.md
apps/*/README.md
apps/*/src/generated
