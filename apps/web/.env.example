# ============================================================
# apps/web/.env.example — copie para apps/web/.env.local
#   bash:       cp apps/web/.env.example apps/web/.env.local
#   PowerShell: Copy-Item apps/web/.env.example apps/web/.env.local
#   (ou rode `pnpm setup` na raiz)
# NUNCA versione o apps/web/.env.local.
# ============================================================

# URL pública da API, usada pelo BROWSER (portanto host, não nome de serviço Docker).
# É embutida no bundle em build time pelo prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:3001
