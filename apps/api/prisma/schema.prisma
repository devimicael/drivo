// Modelos persistidos. A URL do datasource é configurada em prisma.config.ts.
// Arquivos CRLV não são armazenados; os dados extraídos são revisados antes de salvar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles Vehicle[]

  @@map("users")
}

model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  placa         String   @db.VarChar(10)
  marca         String   @db.VarChar(60)
  modelo        String   @db.VarChar(80)
  ano           Int
  chassi        String   @db.VarChar(17)
  renavam       String?  @db.VarChar(20)
  cor           String?  @db.VarChar(40)
  combustivel   String?  @db.VarChar(40)
  apelido       String?  @db.VarChar(80)
  cilindrada    Int?
  tipo          String?  @db.VarChar(40)
  uf            String?  @db.Char(2)
  anoFabricacao Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prefixo `userId` já cobre o filtro por dono: índice próprio seria redundante.
  @@unique([userId, placa], name: "user_placa_unique")
  @@map("vehicles")
}
