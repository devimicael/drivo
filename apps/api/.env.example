# ============================================================
# apps/api/.env.example — copie para apps/api/.env
#   bash:       cp apps/api/.env.example apps/api/.env
#   PowerShell: Copy-Item apps/api/.env.example apps/api/.env
#   (ou rode `pnpm setup` na raiz, que gera segredos aleatórios)
# NUNCA versione o apps/api/.env.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3001

# --- Banco de dados ---
# Host (fora do Docker): 5433 = porta publicada pelo compose.
# Dentro do Docker o compose sobrescreve com postgres:5432.
DATABASE_URL=postgresql://drivo:drivo@localhost:5433/drivo?schema=public

# --- Autenticação (JWT + CSRF) — mínimo 32 caracteres, distintos entre si ---
JWT_SECRET=troque-por-uma-string-aleatoria-com-no-minimo-32-caracteres
JWT_TTL_SECONDS=3600
CSRF_SECRET=troque-por-uma-string-aleatoria-distinta-da-jwt-secret
# false = cookie sem Secure (necessário em http://localhost).
# Comente/remova esta linha em produção: o padrão passa a ser Secure=true.
COOKIE_SECURE=false

# --- CORS (origens explícitas, separadas por vírgula) ---
# Em desenvolvimento a API também permite localhost:3001 e 127.0.0.1:3001
# automaticamente para o Swagger; production aceita apenas esta lista explícita.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate limiting (por IP, janela deslizante) ---
# Valores folgados para desenvolvimento/avaliação. Aperte em produção.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=20
SCAN_THROTTLE_LIMIT=10

# --- Upload de CRLV ---
UPLOAD_MAX_BYTES=5242880

# --- Gemini (opcional: sem a chave a API sobe e o import responde 502 controlado) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
