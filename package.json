{
  "name": "drivo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "pnpm --filter drivo-api start:dev",
    "dev:web": "pnpm --filter drivo-web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter drivo-api test",
    "test:e2e": "pnpm --filter drivo-api test:e2e",
    "test:cov": "pnpm --filter drivo-api test:cov",
    "test:web": "pnpm --filter drivo-web test",
    "db:generate": "pnpm --filter drivo-api prisma:generate",
    "db:migrate": "pnpm --filter drivo-api prisma:deploy",
    "db:migrate:dev": "pnpm --filter drivo-api exec prisma migrate dev"
  }
}
